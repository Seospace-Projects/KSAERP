# Copy to .env and fill in real values. Never commit .env.

# GEMINI_API_KEY: server-only. Used by /api/translate. Do not prefix with VITE_.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: public origin used for CORS and password-reset redirects. Not a secret.
# On Vercel set this to your deployment URL, e.g. https://your-app.vercel.app
APP_URL="http://localhost:3000"

# PORT: HTTP listen port (optional).
PORT="3000"

# ---------------------------------------------------------------------------
# Supabase
# Project Settings → API
# VITE_ vars are inlined into the browser bundle (same idea as NEXT_PUBLIC_).
# Only the anon/publishable key may use VITE_, and only because RLS is enabled
# on every table in supabase/schema.sql.
# The service role key must NEVER use a VITE_ prefix.
# ---------------------------------------------------------------------------
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Seed passwords for `npm run seed:auth` (server-only, never VITE_).
# Rotate these before any public deploy. Do not reuse values that were
# previously hardcoded in source.
SEED_PASSWORD_SUPERADMIN="CHANGE_ME_SUPERADMIN"
SEED_PASSWORD_ADMIN="CHANGE_ME_ADMIN"
SEED_PASSWORD_ACCOUNTANT="CHANGE_ME_ACCOUNTANT"
SEED_PASSWORD_SALES="CHANGE_ME_SALES"
SEED_PASSWORD_INVENTORY="CHANGE_ME_INVENTORY"
SEED_PASSWORD_VIEWER="CHANGE_ME_VIEWER"
